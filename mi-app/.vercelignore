# Vercel ignore - archivos/carpetas que NO se suben al deploy

# Dependencies
node_modules/

# Build output (Vercel lo regenera)
dist/

# Test artifacts
playwright-report/
test-results/
coverage/

# Test files
tests/
playwright.config.ts
playwright.config.js

# Config files (no necesarios en producción)
.oxlintrc.json
# tsconfig.json - necesario para build
# tsconfig.app.json - necesario para build
# tsconfig.node.json - necesario para build
# vite.config.ts - necesario para tsconfig.node.json include
# vite.config.js - necesario para build

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
*.local
*.md
README.md
LICENSE

# Medios sin procesar (los de producción están en public/media/)
media/